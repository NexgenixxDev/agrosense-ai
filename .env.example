NODE_ENV=development
DEV_AUTH=true
PORT=4100
WEB_ORIGIN=http://localhost:5173
DATABASE_PATH=../../data/agrosense.sqlite
IMAGE_PATH=../../data/images
AI_URL=http://127.0.0.1:8100
AI_SERVICE_TOKEN=local-development-only
# unavailable | fixture | real | claude | gemini
# claude: Claude looks at each photo (needs ANTHROPIC_API_KEY, paid per use)
# gemini: Gemini looks at each photo (needs GEMINI_API_KEY, free tier available)
AI_MODE=unavailable
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# real mode: endpoint implementing docs/inference-contract.md, not a guessed vendor API
INFERENCE_URL=
INFERENCE_API_KEY=
MODEL_VERSION=
SUPPORTED_CONDITIONS_JSON={}
# Only true after appropriate field evaluation and documented acceptance rules
MODEL_VALIDATED=false
